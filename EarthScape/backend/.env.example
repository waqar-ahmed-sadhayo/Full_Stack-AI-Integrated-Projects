# ---- Core ----
DEMO_MODE=true
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ---- MongoDB (used when reachable; DEMO_MODE falls back to local JSON store if not) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=earthscape

# ---- JWT Auth ----
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Storage paths (DEMO_MODE local filesystem HDFS simulation) ----
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_LOCAL_ROOT=../data/hdfs_simulated
UPLOAD_DIR=../data/uploads
MODEL_DIR=../models
REPORT_DIR=../reports

# ---- Limits ----
MAX_UPLOAD_SIZE_MB=50

# ---- Optional Kafka (not required in DEMO_MODE) ----
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_ENABLED=false

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120
